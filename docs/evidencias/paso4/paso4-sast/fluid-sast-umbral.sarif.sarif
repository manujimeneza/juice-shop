{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.4.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Fluid Attacks SAST",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "130",
              "name": "Insecurely generated cookies - Secure",
              "fullDescription": {
                "text": "The system does not set the Secure attribute for sensitive cookies, which could cause them to be sent through an insecure channel.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/130",
              "help": {
                "text": "The application must set the Secure attribute in the cookies with sensitive information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "204",
              "name": "Insufficient data authenticity validation",
              "fullDescription": {
                "text": "The application does not control on the server if someone have permission to modify certain fields and allows to use invalid data in some fields, for example non-existing names.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/204",
              "help": {
                "text": "Validate on the server side the types of data that are entered into different types of fields in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "459",
              "name": "Observable Timing Discrepancy",
              "fullDescription": {
                "text": "An attacker may infer sensitive information by observing differences in response times, exposing internal data such as tokens, credentials, or validation states.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/459",
              "help": {
                "text": "- Use constant-time comparisons for sensitive data (e.g., MessageDigest.isEqual in Java). - Avoid error messages or behaviors that vary depending on the point of failure. - Introduce uniform response times whenever possible.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "262",
              "name": "Insecure encryption algorithm - SHA1",
              "fullDescription": {
                "text": "The server where the application is stored supports insecure ciphers - SHA1.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/262",
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "395",
              "name": "Insecure generation of random numbers -  Static IV",
              "fullDescription": {
                "text": "The application uses static, hardcoded values for initialization vectors. By knowing initialization vectors an attacker could perform a reverse engineering attack to predict the random values that should remain as secrets.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/395",
              "help": {
                "text": "Generate initialization vectors randomly using mechanisms with secure randomness and high entropy.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "313",
              "name": "Insecure service configuration - Certificates",
              "fullDescription": {
                "text": "Due to a misconfiguration of X.509 certificates, the application can accept invalid certificates, making it possible to carry out Man in The Middle attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/313",
              "help": {
                "text": "Throw typed exceptions in case of detection of invalid certificates.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "414",
              "name": "Insecure service configuration - Header Checking",
              "fullDescription": {
                "text": "The application disables the HeaderChecking property, which enables the encoding of newlines and carriage returns, thus allowing the injection of malicious headers\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/414",
              "help": {
                "text": "Set the EnableHeaderChecking property to true, of remove the line that sets the property in false, since its default value is true\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "010",
              "name": "Stored cross-site scripting (XSS)",
              "fullDescription": {
                "text": "It is possible to persistently inject JavaScript code into the application fields. This could allow an attacker to compromise the session of any user who enters the platform or to distribute malicious software.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/010",
              "help": {
                "text": "Filter the information that receives and sends the application using white lists.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "058",
              "name": "Debugging enabled in production - APK",
              "fullDescription": {
                "text": "The system has debugging enabled in the production environment, which can cause technical information leaks when an error occurs.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/058",
              "help": {
                "text": "Configure the attribute: application.android:debuggable to false in the file: AndroidManifest.xml.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "045",
              "name": "HTML code injection",
              "fullDescription": {
                "text": "The applications fields allow the injection of HTML code. This could enable attackers to modify the applications appearance in order to trick its users into performing undesired actions.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/045",
              "help": {
                "text": "Filter the information that comes from text fields with regular expressions or white lists to avoid injections.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "213",
              "name": "Business information leak - JWT",
              "fullDescription": {
                "text": "Business information is obtained within the JWT, such as:\n- Username\n- Password\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/213",
              "help": {
                "text": "Remove the sensitive information from the JWT and manage this kind of information in the server-side.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "160",
              "name": "Excessive privileges - Temporary Files",
              "fullDescription": {
                "text": "The application creates temporary withouth properly restricting their privileges or access modes, allowing an attacker to craft new attack vectors\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/160",
              "help": {
                "text": "Create the temporary files in a different directory than the default provided by the Operative system and ensure it has 0600 permission mask.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "270",
              "name": "Insecure functionality - File Creation",
              "fullDescription": {
                "text": "For an authenticated user with a profile that restricts certain functions, the restriction is performed on the front end by disabling the corresponding button, which can be bypassed and the query is processed when it is sent.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/270",
              "help": {
                "text": "Verify on the server side that the user making the request has sufficient permissions.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "106",
              "name": "NoSQL injection",
              "fullDescription": {
                "text": "The system generates NoSQL queries dynamically and without validating untrusted inputs.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/106",
              "help": {
                "text": "Validate and escape data that will be included in sentences generated dynamically.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "276",
              "name": "Sensitive information sent via URL parameters - Session",
              "fullDescription": {
                "text": "The JWT session token is sent by the URL, which allows it to be cached by the browsing history, allowing attackers with local access to the machine to obtain it without any problem.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/276",
              "help": {
                "text": "Use secure mechanisms to send sensitive information between sites so that it cannot be stolen by malicious actors.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "042",
              "name": "Insecurely generated cookies",
              "fullDescription": {
                "text": "The system does not set security attributes for sensitive cookies, which could cause them to be sent in plain text or disclosed by unauthorized users on the client side.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/042",
              "help": {
                "text": "The application must set the corresponding security attributes when cookies are generated.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "068",
              "name": "Insecure session expiration time",
              "fullDescription": {
                "text": "User sessions do not expire after 5 minutes of inactivity.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/068",
              "help": {
                "text": "Close the sessions when they remain inactive more than 5 minutes.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "128",
              "name": "Insecurely generated cookies - HttpOnly",
              "fullDescription": {
                "text": "The applications cookies are generated without properly setting the HttpOnly attribute.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/128",
              "help": {
                "text": "The application must set the HttpOnly attribute in the cookies with sensitive information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "098",
              "name": "External control of file name or path",
              "fullDescription": {
                "text": "It is possible to modify the path to which an uploaded file will be saved.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/098",
              "help": {
                "text": "Validate uploaded files names on the system and restrict the storage to destined folders only.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "183",
              "name": "Debugging enabled in production",
              "fullDescription": {
                "text": "The system has the debug mode active which generates an information leak when an error is generated.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/183",
              "help": {
                "text": "Make sure that debugging mode is not enabled in the production environment and remove statements or portions of code that are executing in debugging mode.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "043",
              "name": "Insecure or unset HTTP headers - Content-Security-Policy",
              "fullDescription": {
                "text": "The application has unsafe configurations regarding the Content-Security-Policy header. This may be because:\n- Header is missing from server responses.\n- The header has not defined mandatory security policies.\n- Defined security policies contain insecure values.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/043",
              "help": {
                "text": "Set the Content-Security-Policy header in the server responses and configure it in a secure way.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "309",
              "name": "Insecurely generated token - JWT",
              "fullDescription": {
                "text": "The token used to consume the user creation service in the application is not generated securely, because the key that signs the token is weak and was easily found as indicated in the finding of weak credentials. For this reason, an attacker can modify token parameters such as the expiration date to consume the service, and perform queries in the application.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/309",
              "help": {
                "text": "Use strong passwords for signing and verification of the user creation token.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "332",
              "name": "Use of insecure channel - Source code",
              "fullDescription": {
                "text": "Customer information is transmitted over a channel that does not use encryption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/332",
              "help": {
                "text": "Deploy the application over an encrypted communication channel, e.g. HTTPS using TLS.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "056",
              "name": "Anonymous connection",
              "fullDescription": {
                "text": "Due to an improper configuration of the server (e.g., an FTP service with username: anonymous and password: guest or an SMTP open relay), it is possible to make anonymous connections to it and access otherwise protected resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/056",
              "help": {
                "text": "Configure the services to avoid services enumeration or to connect to these anonymously.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "317",
              "name": "Improper resource allocation - Memory leak",
              "fullDescription": {
                "text": "The system may not be able to release inbound and outbound flow resources that have been opened, because they are not explicitly closed within the source code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/317",
              "help": {
                "text": "Outflows must be explicitly shut down immediately after use.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "134",
              "name": "Insecure or unset HTTP headers - CORS",
              "fullDescription": {
                "text": "The cross-domain policy includes wildcards, accepting any domain as valid for sharing resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/134",
              "help": {
                "text": "Remove the wildcard (*) and define explicitly the trusted origins for the application resources.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "004",
              "name": "Remote command execution",
              "fullDescription": {
                "text": "The system builds OS commands using inputs that can be manipulated externally, it does not correctly neutralize special elements that could modify the OS command.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/004",
              "help": {
                "text": "- If at all possible, use standard library calls rather than external processes to recreate the desired functionality.\n- Keep as much data as possible used to generate command outside of external control.\n- Properly escape the arguments used to generate the command and avoid special characters.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "272",
              "name": "Insecure functionality - Masking",
              "fullDescription": {
                "text": "The system is not masking the data in the request and/or response, allowing sensitive and confidential information to be known.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/272",
              "help": {
                "text": "The system sends sensitive information through a channel or method that does not guarantee its confidentiality or integrity.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "090",
              "name": "CSV injection",
              "fullDescription": {
                "text": "It is possible to inject formulas into fields that are later exported as part of CSV files and can be interpreted by Excel.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/090",
              "help": {
                "text": "Sanitize all the fields that will be exported to the server when the exported file is generated.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "147",
              "name": "Insecure encryption algorithm - SSLContext",
              "fullDescription": {
                "text": "An SSLContext object implements the specified secure socket protocol. However, not all protocols are equal and some legacy protocols, such as SSL, have proven to be insecure.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/147",
              "help": {
                "text": "Only secure encryption with secure algorithms such as TLSv1.2 or higher should be allowed.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "250",
              "name": "Non-encrypted hard drives",
              "fullDescription": {
                "text": "Disk or hard drives without encryption, leave data stored on a computer or network storage system unprotected. Full disk encryption is a great way to protect sensitive customer data.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/250",
              "help": {
                "text": "Set the encrypted property for all the hard drives instances defined as code.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "096",
              "name": "Insecure deserialization",
              "fullDescription": {
                "text": "The system deserializes objects without first validating their content nor casting them to a specific type.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/096",
              "help": {
                "text": "Validate the incoming serialized objects and only deserialize them if they meet expected properties.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "159",
              "name": "Excessive privileges",
              "fullDescription": {
                "text": "A user with access to the application can generate an error within the application to gain access to the SharePoint platform. From which they can create groups with excessive privileges, to use functions that were not possible to access initially. Also, they can modify or remove permissions that other users or groups have on the application and share content with users who initially did not have access.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/159",
              "help": {
                "text": "Configure the application so that users cannot modify their permissions.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "434",
              "name": "Client-side template injection",
              "fullDescription": {
                "text": "The application allows injecting malicious entries into a client-side command template. This vulnerability occurs when an attacker can use the template's template syntax to inject a malicious payload into a template, which is then executed on the client side.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/434",
              "help": {
                "text": "Properly sanitize user-controlled inputs.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "100",
              "name": "Server-side request forgery (SSRF)",
              "fullDescription": {
                "text": "It is possible to induce the application's server into making requests to an arbitrary domain.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/100",
              "help": {
                "text": "The system must avoid that the information query from the server be controlled by users. If this is necessary, the system must restrict the endpoints accepted for query.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "083",
              "name": "XML injection (XXE)",
              "fullDescription": {
                "text": "It is possible to inject XML code into the application's requests, which is then interpreted by the server. This could allow an attacker to perform data exfiltration or execute commands remotely.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/083",
              "help": {
                "text": "Filter the information that is received and sent by the application through white lists.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "028",
              "name": "Insecure temporary files",
              "fullDescription": {
                "text": "The system uses temporary files to store sensitive information. Alternatively, the system deploys sensitive temporary files to the production environment.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/028",
              "help": {
                "text": "Avoid saving sensitive information in server files.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "354",
              "name": "Insecure file upload - Files Limit",
              "fullDescription": {
                "text": "There is no limit to the number of files that can be uploaded to the system per unit of time, and uploading a new one does not delete the previous one from the server.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/354",
              "help": {
                "text": "Delete previous avatar files when uploading a new one, apply throttling.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "412",
              "name": "Lack of protection against deletion - Azure Key Vault",
              "fullDescription": {
                "text": "Some Azure Key Vaults instances do not enable properties that allow secrets to be recovered in the event of accidental deletion or by malicious actors.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/412",
              "help": {
                "text": "Enable the properties EnableSoftDelete and EnablePurgeProtection in every Azure Key Vault (AKV) instance.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "266",
              "name": "Excessive Privileges - Docker",
              "fullDescription": {
                "text": "The containers executed in the application do not properly restrict the privileges of the users, executing tasks with root user instead of a custom user.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/266",
              "help": {
                "text": "- Restrict the privileges of the user that execute instructions inside the container.\n- Avoid the use of the root user as default user.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "089",
              "name": "Lack of data validation - Trust boundary violation",
              "fullDescription": {
                "text": "The system mixes trusted and untrusted data in the same data structure or structured message.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/089",
              "help": {
                "text": "- Prevent the use of untrusted data in critical data structures or structured messages.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "027",
              "name": "Insecure file upload",
              "fullDescription": {
                "text": "The system allows the upload of files with two extensions or with unsafe ones, such as .html, .php or .exe. Furthermore, the system does not validate whether or not the file is free from malicious code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/027",
              "help": {
                "text": "- Validate with regular expressions that the file has only one extension.\n- Validate with an antivirus software that the file does not contain any type of malicious code.\n- Validate that Content Type corresponds to the files extension before upload it to the server.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "371",
              "name": "DOM-Based cross-site scripting (XSS)",
              "fullDescription": {
                "text": "The web application generates dynamic web content from the client side without validating the origin of the potentially malicious data.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/371",
              "help": {
                "text": "Perform server-side and client-side input data validation to avoid the most common script injection attacks.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "320",
              "name": "Insecure service configuration - LDAP",
              "fullDescription": {
                "text": "Internal service information should not be stored in the source code, especially AD configurations, as it is obtained from the admon-chanel configuration file.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/320",
              "help": {
                "text": "Service configurations and credentials must be in protected environments.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "346",
              "name": "Excessive privileges - Mobile App",
              "fullDescription": {
                "text": "The application defines unnecessary permissions that can be abused by an attacker to perform unauthorized read or write operations in the device.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/346",
              "help": {
                "text": "Disable unnecessary permissions, complying with the principle of least privilege\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "082",
              "name": "Insecurely deleted files",
              "fullDescription": {
                "text": "It is possible to retrieve deleted files with sensitive information because they were merely sent to the Recycle Bin or removed using insecure protocols.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/082",
              "help": {
                "text": "Good practices must be followed to clean, delete, and destruction of sensitive information (Policies).\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "035",
              "name": "Weak credential policy",
              "fullDescription": {
                "text": "The application's credential policy does not enforce the technical parameters required to resist guessing attacks: it allows passwords or passphrases below the recommended minimum length (or caps them below the recommended maximum), does not reject weak, word-based, previously breached, or context-specific credentials (e.g., username, app name), issues temporary passwords or OTPs (e.g., for account recovery, first login, or MFA) that are short-lived or short in name only, without sufficient entropy or length, and/or allows credentials to be shared or reused across multiple users or accounts.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/035",
              "help": {
                "text": "- Require passphrases of at least four words or passwords of at least 20 characters, rather than short, word-based passwords, and do not impose an arbitrarily low maximum length that would reject strong passphrases.\n- Reject passwords found in known breach databases (e.g., via the HaveIBeenPwned API) and passwords built from context-specific words (e.g., username, service name) at creation and change time.\n- Generate temporary passwords and OTPs (recovery, first login, MFA, admin-issued) with sufficient entropy (temporary passwords: minimum 12 characters, mixed case, digits, and symbols; OTPs: minimum 6 digits) and force expiry after first use or within a short window (e.g., 15 minutes).\n- Require each user or system to have a unique, non-shared credential; reusing or sharing credentials across accounts prevents individual accountability and multiplies the impact of a single compromise.\n- Do not enforce arbitrary periodic password expiration without evidence of compromise: per NIST SP 800-63B, mandatory rotation leads users to choose weaker, predictable passwords. Enforce expiration only upon detected compromise, or per an applicable compliance requirement, and require MFA for all privileged accounts.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "091",
              "name": "Log injection",
              "fullDescription": {
                "text": "The system logs entries that contain input from untrusted sources without properly validating, sanitizing or escaping their content.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/091",
              "help": {
                "text": "Sanitize inputs before storing them in the log.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "081",
              "name": "Lack of multi-factor authentication",
              "fullDescription": {
                "text": "Critical services of the system, such as databases, shared resources containing sensitive information and web services, are not protected by a multi-factor authentication mechanism. This makes it easier for an attacker who has compromised a user's account to access those resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/081",
              "help": {
                "text": "Implement a double factor authentication by software or hardware to increase the protection level of the resources authentication.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "263",
              "name": "Insecure encryption algorithm - MD5",
              "fullDescription": {
                "text": "The web application uses insecure algorithms such as MD5 to hash passwords.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/263",
              "help": {
                "text": "Use secure hashing algorithms to store passwords like PBKDF2.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "131",
              "name": "Insecure or unset HTTP headers - Strict Transport Security",
              "fullDescription": {
                "text": "The server is missing the Strict-Transport-Security HTTP header. Alternatively, the headers max-age is too short.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/131",
              "help": {
                "text": "Set the Strict-Transport-Security header with a max-age 63072000 and the includeSubDomains\n directive on all server responses.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "129",
              "name": "Insecurely generated cookies - SameSite",
              "fullDescription": {
                "text": "The applications cookies are generated without properly setting the SameSite attribute.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/129",
              "help": {
                "text": "The application must set the SameSite attribute in the cookies with sensitive information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "316",
              "name": "Improper resource allocation - Buffer overflow",
              "fullDescription": {
                "text": "Within the code there are unsafe statements that can affect the performance and response time of the application. See https://rules.sonarsource.com/java/RSPEC-1149?search=stringbuffer for more information.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/316",
              "help": {
                "text": "Use the libraries that allow to execute the functions of concatenation and storage in collections in an optimized way (ArrayList and StringBuilder or SyncronizedList).\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "256",
              "name": "Lack of protection against deletion - RDS",
              "fullDescription": {
                "text": "The current configuration has no protection against deletion, this can lead to the deletion of databases in Amazon Web Services RDS.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/256",
              "help": {
                "text": "Securely configure the Amazon Web Services service, allowing protection against accidental deletion.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "355",
              "name": "Insufficient data authenticity validation - Checksum verification",
              "fullDescription": {
                "text": "The application does not properly validate the integrity of resources loaded from external servers.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/355",
              "help": {
                "text": "Validate the integrity of all resources originating from sources controlled by third parties.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "101",
              "name": "Lack of protection against deletion",
              "fullDescription": {
                "text": "The system does not prevent critical objects from being deleted accidentally.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/101",
              "help": {
                "text": "Set up automatic backup or deletion protection for all storage services with important information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "177",
              "name": "Insecure service configuration - Security Groups",
              "fullDescription": {
                "text": "EC2 Security Groups are not explicitly defined. Security Group input/output rules are not defined.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/177",
              "help": {
                "text": "Securely configure the vulnerable service by explicitly defining the Security Groups.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "017",
              "name": "Sensitive information sent insecurely",
              "fullDescription": {
                "text": "Sensitive information, such as session identifiers, is sent through channels or methods that do not guarantee its confidentiality, including unencrypted connections or URL query parameters.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/017",
              "help": {
                "text": "- Transmit sensitive information only over encrypted channels, such as HTTPS with TLS 1.2 or higher.\n- Do not place session identifiers or other sensitive data in URL query parameters; use the request body, secure cookies, or headers instead, since encryption alone does not prevent their exposure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "300",
              "name": "Authentication mechanism absence or evasion - Azure",
              "fullDescription": {
                "text": "The system has flaws over authentication mechanisms or had been configured with one that can be bypassed.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/300",
              "help": {
                "text": "- Force users to register multiple authentication methods.\n- Enable Azure Fraud alert to empower users to proactively report attempts of someone trying to use their account.\n- Set account lockout thresholds notifications.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "368",
              "name": "Unrestricted access between network segments - StrictHostKeyChecking",
              "fullDescription": {
                "text": "The JSch StrictHostKeyChecking configuration is set to no, this indicates that connections may be made to unknown servers or servers that have changed their keys, generating new ones and adding them by default to the known server files.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/368",
              "help": {
                "text": "- Limit access to administrative services such as SSH.\n- Implement safe values for StricktHostKeyChecking configuration.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "109",
              "name": "Unrestricted access between network segments - RDS",
              "fullDescription": {
                "text": "Some RDS Cluster or Instances are not defined inside a Database Subnet Group.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/109",
              "help": {
                "text": "Ensure that all RDS instances belong to a Database Subnet Group.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "153",
              "name": "Insecure or unset HTTP headers - Accept",
              "fullDescription": {
                "text": "The application does not set the Accept header or allows any MIME type in the requests. An attacker could abuse this feature to cause unexpected behaviors when the application interprets incorrect content-types.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/153",
              "help": {
                "text": "- Set the Accept Header in client requests.\n- Define explicitly the allowed content types for the application.\n- Deny all request that contain a content type different from the expected by the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "335",
              "name": "Insecure service configuration - Bucket",
              "fullDescription": {
                "text": "The native S3 VersioningConfiguration resource, which allows to preserve, recover and restore each version of each object stored in the Buckets due to causes such as malicious actions of users or application failures, is not enabled.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/335",
              "help": {
                "text": "Securely configure the Buckets by enabling the VersioningConfiguration resource.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "394",
              "name": "Insufficient data authenticity validation - Cloudtrail Logs",
              "fullDescription": {
                "text": "One or more Cloudtrail instances do not enable the EnableLogFileValidation attribute avoiding the integrity validation to be performed. This practice could aid an attacker to inject malicious information in log files without raising any alert.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/394",
              "help": {
                "text": "Set the EnableLogFileValidation attribute in true for all Cloudtrail instances.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "008",
              "name": "Reflected cross-site scripting (XSS)",
              "fullDescription": {
                "text": "The web application dynamically generates web content without validating the source of the potentially untrusted data.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/008",
              "help": {
                "text": "Perform input data validations on the server-side to avoid common script injection attacks.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "269",
              "name": "Insecure encryption algorithm - Blowfish",
              "fullDescription": {
                "text": "Insecure algorithms such as Blowfish are used to encrypt the information stored in the code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/269",
              "help": {
                "text": "Use secure algorithms such as AES or RSA.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "358",
              "name": "Insecure service configuration - DocumentBuilderFactory",
              "fullDescription": {
                "text": "DocumentBuilderFactory is insecurely configured, which makes it susceptible to XXE attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/358",
              "help": {
                "text": "Securely configure DocumentBuilderFactory.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "203",
              "name": "Unauthorized access to files - Cloud Storage Services",
              "fullDescription": {
                "text": "Some cloud storage service used by the application can be publicly accessed, without requiring any authentication, allowing an attacker to download its content, modify or delete the stored information\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/203",
              "help": {
                "text": "Restrict the access of the public storage services of the system\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "199",
              "name": "Lack of data validation - Emails",
              "fullDescription": {
                "text": "The application does not control that server-side emails used to register users do not belong to disposable mailboxes such as yopmail.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/199",
              "help": {
                "text": "Implement a blacklisting system with disposable mailbox domains or implement federated authentication.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "259",
              "name": "Lack of protection against deletion - DynamoDB",
              "fullDescription": {
                "text": "The current configuration has no protection against deletion (recovery points in time). The deletion of DynamoDB instances deletes the information without the possibility of recovery.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/259",
              "help": {
                "text": "Securely configure the Amazon Web Services service, enabling protection against accidental deletion with recovery points in time.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "125",
              "name": "Directory listing",
              "fullDescription": {
                "text": "The system displays the applications directories, allowing an attacker to know the content of the files stored on the server.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/125",
              "help": {
                "text": "- Disable the configurations of the server that allow to execute directory listing.\n- Establish index files that will be shown when the directories are loaded.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "037",
              "name": "Technical information leak",
              "fullDescription": {
                "text": "The application or its underlying components expose technical details that aid an attacker in reconnaissance, such as:\n- Component names, versions, or configuration details, exposed through response headers, service banners, configuration files, or framework-specific markers.\n- Internal network information, such as internal IP addresses, exposed in responses.\n- Debug or diagnostic output, such as console logging or alert functions, left enabled in production code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/037",
              "help": {
                "text": "- Remove service banners, HTTP headers, and framework-specific markers that reveal component names or versions.\n- Restrict access to configuration files and internal network details such as IP addresses.\n- Disable or remove debug and diagnostic output, such as console logging or alert functions, in production environments; log errors through a protected logging mechanism instead.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "265",
              "name": "Insecure encryption algorithm - AES",
              "fullDescription": {
                "text": "The source code uses RSA/ECB/PKCS1Padding and AES/CBC/PKCS5PADDING encryption and other references use CTR or CFB which are considered insecure.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/265",
              "help": {
                "text": "Only secure encryption with secure algorithms such as RSA/NONE/OAEPwithSHA-256andMGF1Padding or use implementations with the GCM mode encryption algorithm.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "060",
              "name": "Insecure service configuration - Host verification",
              "fullDescription": {
                "text": "The system does not properly restrict incoming connections from unknown external hosts.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/060",
              "help": {
                "text": "Validate that incoming connections come from trusted hosts already defined in the known_hosts file.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "234",
              "name": "Technical information leak - Stacktrace",
              "fullDescription": {
                "text": "Errors or exceptional events are not properly handled by the application allowing an attacker to disclose technical information from system error traces:\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/234",
              "help": {
                "text": "- Remove functions that print technical information such as PrintStacktrace from the source code\n\n - Handle errors with typified exceptions\n and store them in duly protected logs\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "149",
              "name": "Use of an insecure channel - SMTP",
              "fullDescription": {
                "text": "The configuration of the SMTP service is set to not use SSL, so confidential information traveling by this means that can be viewed without any type of encryption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/149",
              "help": {
                "text": "Deploy the application over an encrypted communication channel, use SSL secure protocols.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "333",
              "name": "Insecure service configuration - EC2",
              "fullDescription": {
                "text": "Some EC2 instances have insecure configurations that an attacker can use to access or interrupt critical application processes\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/333",
              "help": {
                "text": "Perform a hardening process over all the EC2 instances, by following the recommended best practices\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "359",
              "name": "Sensitive information in source code - Credentials",
              "fullDescription": {
                "text": "The repository stores sensitive information such as users, passwords, emails, API credentials, among others.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/359",
              "help": {
                "text": "- Remove the hardcoded sensitive information and purge git logs\n- Change login credentials that were compromised.\n- Load sensitive data from secure sources such as key vault, encrypted configuration files or environment variables.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "282",
              "name": "Insecure encryption algorithm - ECB",
              "fullDescription": {
                "text": "Encryption algorithms are handled in ECB mode, which is insecure.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/282",
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "267",
              "name": "Excessive Privileges - Kubernetes",
              "fullDescription": {
                "text": "Kubernetes default configuration is overly permissive, allowing users to escalate privileges or execute commands as privileged users.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/267",
              "help": {
                "text": "Set strict security policy disabling potentially harmful actions and restricting the user permissions.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "152",
              "name": "Insecure or unset HTTP headers - X-Frame Options",
              "fullDescription": {
                "text": "The application uses the X-Frame Options header on the server responses as the only protection mechanism against clickjacking. This header is considered deprecated, since its protection can be bypassed using several iframe layers.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/152",
              "help": {
                "text": "- Disable the X-Frame Options from the server responses.\n- Define the frame_ancestors policy in the Content Security Policy header.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "078",
              "name": "Insecurely generated token",
              "fullDescription": {
                "text": "It is possible to crack the token's hash and obtain the information it is masking because it is not generated using a secure cryptographic mechanism.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/078",
              "help": {
                "text": "Generate a token with random components without sensitive information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "108",
              "name": "Improper control of interaction frequency",
              "fullDescription": {
                "text": "The system does not limit the amount of requests (rate limit) that a user can post to the server in a short period of time.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/108",
              "help": {
                "text": "Limit the number of requests that can be made by the same host in defined time slots.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "146",
              "name": "SQL injection",
              "fullDescription": {
                "text": "Dynamic SQL statements are built by concatenating untrusted input (from query parameters, HTTP headers, or other request fields) without the required data validation and without using parameterized statements, prepared statements, or stored procedures free of internal concatenation. This also includes ORM-based query languages (e.g., JPQL, HQL), expression bindings (e.g., SpEL) that evaluate attacker-controlled values as part of the query, and dynamic identifiers (table names, column names, sort order) built from untrusted input, which parameterized statements alone cannot protect.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/146",
              "help": {
                "text": "- Perform database queries through parameterized statements or prepared statements instead of string concatenation. A stored procedure is only safe if it does not itself build dynamic SQL by concatenating its parameters (e.g., via 'sp_executesql' or 'EXEC'); used that way, it is just as injectable as inline concatenation.\n- Parameters cannot be used for dynamic identifiers (table names, column names, 'ORDER BY' direction); validate these against a strict allow-list of expected values instead.\n- When using LIKE-conditions with user-supplied values, sanitize wildcard characters explicitly (e.g., using the escape(String) function); parameterization alone does not prevent wildcard injection in LIKE clauses.\n- Run database queries with a least-privilege account scoped to only the operations and tables the application needs, to limit the impact of any injection that does occur.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "067",
              "name": "Improper resource allocation",
              "fullDescription": {
                "text": "The system allocates unnecessary resources due to the use of improper programming practices or inefficient algorithms. Alternatively, the allocation can be controlled by an external source (e.g., user input), and hence, requests that consume an enormous amount of resources are processed without any restriction.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/067",
              "help": {
                "text": "Use stable and optimized libraries to perform functions without a large computational expense.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "009",
              "name": "Sensitive information in source code",
              "fullDescription": {
                "text": "The source code repository contains sensitive information such as usernames, passwords, email addresses and IP addresses, among others. Alternatively, while values may be password=123 o aws.secret_key=test, they reveal the bad practice of storing sensitive information in the repository with no encryption, and sooner or later they can be replaced for real sensitive values.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/009",
              "help": {
                "text": "- Delete all hardcoded sensitive information.\n- Change all affected access credentials.\n- Remove sensitive information from git logs.\n- Load sensitive data from safe sources such as, key vault services, configuration files properly encrypted or administrative environment variables.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "157",
              "name": "Unrestricted access between network segments",
              "fullDescription": {
                "text": "The current network configuration lacks access restrictions between network segments, which would allow an attacker to access privileged server segments or services from unauthorized networks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/157",
              "help": {
                "text": "Segment the corporate network using the principle of least privilege necessary to limit access to the database.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "350",
              "name": "Insecure digital certificates - Chain of trust",
              "fullDescription": {
                "text": "Due to improper implementation of the TrustManager checkServerTrusted method, methods are created that do not throw a certificate exception when invalid certificates are detected. Thanks to this it is possible to accept any incoming certificate and materialize Man in The Middle attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/350",
              "help": {
                "text": "Define a processing logic for invalid certificates that includes rejecting the connection to such certificates and storing the technical details of the event in logs.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "339",
              "name": "Insecure service configuration - Request Validation",
              "fullDescription": {
                "text": "No requestValidationMode is assigned in the server configuration files, which would allow XSS attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/339",
              "help": {
                "text": "Activate recommended protection mechanisms such as Request Validation.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "024",
              "name": "Unrestricted access between network segments - AWS",
              "fullDescription": {
                "text": "The infrastructure definition for network segments in the AWS context is too permissive.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/024",
              "help": {
                "text": "Limit network segments, ports, IP addresses, network protocols, and administrative services only to the required users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "071",
              "name": "Insecure or unset HTTP headers - Referrer-Policy",
              "fullDescription": {
                "text": "The server is missing the Referrer-Policy HTTP header. Alternatively, the headers configuration is unsafe.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/071",
              "help": {
                "text": "Set the Referrer-Policy header to no-referrer, same-origin, strict-origin, or strict-origin-when-cross-origin in the server responses.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "380",
              "name": "Supply Chain Attack - Docker",
              "fullDescription": {
                "text": "Docker dependencies are not pinned to an exact digest, making the Docker build unable the verify the integrity of the image and allowing a malicious actor to override the used components with malicious components without leaving a trace.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/380",
              "help": {
                "text": "Use mechanisms such as git-commits, or artifacts and hashes to verify the data integrity.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "065",
              "name": "Cached form fields",
              "fullDescription": {
                "text": "The application does not disable caching of input fields, thus the information will be stored in the browser's cache.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/065",
              "help": {
                "text": "The data cache to browsers level must be disabled using some of these methods:\n- Use HTTP control headers that prevent cache.\n- Use meta-tags in HTML pages.\n- Disable the autocomplete field to prevent cache to fields level.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "055",
              "name": "Insecure service configuration - ADB Backups",
              "fullDescription": {
                "text": "The application allows backups via ADB (Android Debug Bridge). The backups performed by this functionality are not encrypted. Sensitive data of authenticated users can be included in the backup, and this data can be extracted by a non-authenticated attacker. Additionally, data can be copied into a USB stick and be moved out of the sphere of control of the application.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/055",
              "help": {
                "text": "Configure the attribute: application.android:allowBackup to false in the file: AndroidManifest.xml.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "402",
              "name": "Traceability Loss - Azure",
              "fullDescription": {
                "text": "The Azure configurations do not enable the log service with enough granularity. Omitting relevant information may hinder the detection of anomalous behaviors or security breaches.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/402",
              "help": {
                "text": "Configure the logs with the necessary granularity level to detect and identify potentially harmful behaviors by enabling logging for read, write and delete requests.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "059",
              "name": "Sensitive information stored in logs",
              "fullDescription": {
                "text": "The system stores sensitive information such as credentials, bank accounts and file paths in log files.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/059",
              "help": {
                "text": "Verify that the information stored in logs is not sensitive.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "022",
              "name": "Use of an insecure channel",
              "fullDescription": {
                "text": "The system transmits information through a channel without encryption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/022",
              "help": {
                "text": "Deploy the application over an encrypted communication channel, for instance, HTTPS with TLS.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "117",
              "name": "Unverifiable files",
              "fullDescription": {
                "text": "Files are stored in the repository that cannot be verified because their content is not compatible with their extension.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/117",
              "help": {
                "text": "- Remove the files that should not be versioned from the repository.\n- Include the affected extensions in the .gitignore file.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "280",
              "name": "Session Fixation",
              "fullDescription": {
                "text": "The cookie session doesn't change after a valid login which allow an attacker to hijack the user session by setting the user cookie for one known by the attacker.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/280",
              "help": {
                "text": "Invalidate the anonymous cookie and create a new one after a successful login.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "268",
              "name": "Insecure service configuration - Webview",
              "fullDescription": {
                "text": "The application enables the use of JavaScript through the method setJavaScriptEnabled which is disabled by default. This practice increases the chances for an attacker to exploit XSS vulnerabilities.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/268",
              "help": {
                "text": "- Unless required otherwise the application must not allow the use of JavaScript.\n- If the use of JavaScript is enabled, implement content and length validations in all the input fields.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "062",
              "name": "Concurrent sessions",
              "fullDescription": {
                "text": "The application does not validate the number of active sessions each user has, thus a user can login more than once at the same time. Furthermore, the application does not notify the user when a session has already been initiated nor when a second one commences from a different location.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/062",
              "help": {
                "text": "The system must restrict the number of concurrent sessions that a user can establish and at the same it must notify the user when a login from a different location occurs.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "195",
              "name": "Lack of data validation - Headers",
              "fullDescription": {
                "text": "In the source code the information of some HTTP headers is not being validated, so different values could be injected in order to achieve some XSS attack or compromise the integrity of the stored information.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/195",
              "help": {
                "text": "Validate on the server side the types of data that are entered into different kind of fields in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "156",
              "name": "Uncontrolled external site redirect",
              "fullDescription": {
                "text": "Redirects made by the application are not controlled and could be manipulated by an attacker.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/156",
              "help": {
                "text": "Use predefined parameters and not information that can be manipulated by the user for redirection to web sites in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "211",
              "name": "Asymmetric denial of service - ReDoS",
              "fullDescription": {
                "text": "Within the source code there is evidence of the use of dangerous regular expressions, because they make use of complex operations to find matches, which can lead to an attacker sending a specific string of data that could cause the server to crash when evaluating the string with the dangerous regular expression.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/211",
              "help": {
                "text": "Use optimized regular expressions to perform functions without much computational overhead.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "021",
              "name": "XPath injection",
              "fullDescription": {
                "text": "Dynamic XPath statements are generated without the required data validation.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/021",
              "help": {
                "text": "Perform input data validations on the server-side to avoid common injection attacks.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "426",
              "name": "Supply Chain Attack - Kubernetes",
              "fullDescription": {
                "text": "Kubernetes dependencies are not pinned to an exact digest, making the docker build unable the verify the integrity of the image and allowing a malicious actor to override the used components with malicious components without leaving a trace.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/426",
              "help": {
                "text": "Use mechanisms such as git-commits, or artifacts and hashes to verify the data integrity.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "044",
              "name": "Insecure HTTP methods enabled",
              "fullDescription": {
                "text": "HTTP methods such as TRACE, PUT and DELETE are enabled on the server. These methods may allow an attacker to include and/or delete files, or perform cross-site tracing attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/044",
              "help": {
                "text": "Configure secure methods for servers requests.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "353",
              "name": "Lack of data validation - Token",
              "fullDescription": {
                "text": "The generated JWT access token does not validate if the signature is valid so the token can be modified and requests are accepted; even removing the signature from the token works.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/353",
              "help": {
                "text": "Generate a token with random components without sensitive information and always validate that the integrity of the token is maintained (signature verification, signature).\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "442",
              "name": "SMTP header injection",
              "fullDescription": {
                "text": "Email injection is a security weakness that allows a malicious attacker to exploit email-related features, such as email contact forms found on websites, in order to send harmful email content to unintended recipients.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/442",
              "help": {
                "text": "Completely limit unsecured mail functions. Implement the use of specialized services or secure e-mail libraries. Validate incoming data and the escape of data that is not properly encrypted.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "403",
              "name": "Insecure service configuration - usesCleartextTraffic",
              "fullDescription": {
                "text": "The application has android:usesCleartextTraffic set to true, which allows it to access resources that do not use encryption, a situation that could be exploited by an attacker to perform MitM attacks and compromise the confidentiality and integrity of the application.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/403",
              "help": {
                "text": "The android:usesCleartextTraffic must be set to false.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "413",
              "name": "Insecure file upload - DLL Injection",
              "fullDescription": {
                "text": "The application does not properly validate the DLL files, allowing the injection of malicious DLLS\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/413",
              "help": {
                "text": "- Verify with an antivirus that the imported DLLs do not contain virus, backdoors or potentially harmful information\n- Define a white-list of allowed DLLs and their respective integrity hashes\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "447",
              "name": "Supply Chain Attack - Gradle",
              "fullDescription": {
                "text": "The declaration in the property files does not guarantee the integrity of the gradle wrapper which may compromise the compilation which in turn may be affected by malicious code that may be hidden in the compromised third party code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/447",
              "help": {
                "text": "Do not use gradle wrapper from an arbitrary project you have obtained from GitHub or elsewhere on the Internet. Remove it or replace it with a locally generated container. Add the distributionSha256Sum attribute with the SHA-256 checksum corresponding to the distribution referenced in the distributionUrl attribute.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "063",
              "name": "Lack of data validation - Path Traversal",
              "fullDescription": {
                "text": "The software uses external input to construct a pathname that is intended to identify a file or directory but it does not properly neutralize or validate special elements within the pathname.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/063",
              "help": {
                "text": "- Prevent the attacker from constructing the pathname.\n- Validate/Neutralize the input for special elements like: .., ~, /.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "274",
              "name": "Restricted fields manipulation",
              "fullDescription": {
                "text": "From the self-management functionality for the registration of an employee, it is possible to change the information of other employees from other companies. An attacker can initiate a request to confirm the registration of an employee and change the DNI to different values so that it replaces the existing data. In this way the information sent will be stored in the company, updating all the information of the targeted employees such as names, e-mail addresses, dates of birth, addresses, telephone numbers, among others.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/274",
              "help": {
                "text": "Verify that the user who is trying to modify the information has the necessary permissions to access.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "184",
              "name": "Lack of data validation",
              "fullDescription": {
                "text": "The application does not control the the server side where you have permission to modify certain fields and allows the use of invalid data in some fields, for example, an ID composed of only letters.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/184",
              "help": {
                "text": "Validate on the server side the data types that are entered into different kind of fields in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "201",
              "name": "Unauthorized access to files",
              "fullDescription": {
                "text": "In the functionality corresponding to update user data, it is possible to inject potentially dangerous characters that generate inappropriate behavior in the application, exposing the access to Sharepoint and allowing the user to access functionalities and files without authorization.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/201",
              "help": {
                "text": "Validate on the server side the types of data that are entered into different types of fields in the application. Restrict file access to authenticated and authorized users only.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "016",
              "name": "Insecure encryption algorithm - SSL/TLS",
              "fullDescription": {
                "text": "The server allows the usage of insecure TLS protocol versions.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/016",
              "help": {
                "text": "Update TLS protocol to version TLSv1.2 or TLSv1.3 if possible.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "261",
              "name": "Insecure encryption algorithm - DSA",
              "fullDescription": {
                "text": "The server where the application is stored supports insecure encryption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/261",
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "075",
              "name": "Unauthorized access to files - APK Content Provider",
              "fullDescription": {
                "text": "The Content Provider API allows third party applications installed in the device to retrieve data stored by the application. Access to this data must not be allowed to all applications by default. Instead, (and only if required) specific allow-lists must be used.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/075",
              "help": {
                "text": "- Deny access to all Content Providers with: android:exported=false and android:grantUriPermissions=false. If required you can allow specific Content Providers by using grant-uri-permission. - If the attribute android:grantUriPermissions=true is required, establish a custom permission using the permission tag with a Signature protection level.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "362",
              "name": "Technical information leak - Content response",
              "fullDescription": {
                "text": "It is possible to obtain technical information such as:\n- System component versions (HTTP headers, service banner, etc.)\n- Specific information about the configuration of server components (php.ini, web.config)\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/362",
              "help": {
                "text": "Remove web services and files that exposes technical information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "325",
              "name": "Excessive privileges - Wildcards",
              "fullDescription": {
                "text": "- Privileges are granted with wildcard (*) in critical actions.\n- Many roles have unnecessary privileges over IAM.\n- Some write actions allow the use of Wildcards(*).\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/325",
              "help": {
                "text": "Grant privileges strictly to the roles that need it.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "404",
              "name": "OS Command Injection",
              "fullDescription": {
                "text": "The application allows the execution of functions or methods which execute commands in the system with non-sanitized parameters. This action would allow an attacker to inject malicious commands in the server to highly increase the attack vectors by escalating privileges, obtaining or modifying sensitive information stored in the machine.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/404",
              "help": {
                "text": "- If possible, do not use functions that execute commands in the system with inputs controlled by the user.\n- Validate all input parameters using regular expressions or whitelists before passing the parameters to critical functions.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "408",
              "name": "Traceability Loss - API Gateway",
              "fullDescription": {
                "text": "Some AWS API Gateway instances do not enable the logging feature, discarding information that can be managed by other AWS services such as Cloudwatch to detect possible system anomalies\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/408",
              "help": {
                "text": "- Enable the logging feature for all the API gateway instances\n- Set a destination for the log files using other log services such as CloudWatch or Cloudtrail\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "123",
              "name": "Local file inclusion",
              "fullDescription": {
                "text": "The application allows to read or execute files located on the server through relative paths manipulation in the input fields.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/123",
              "help": {
                "text": "- Validate that the parameters received by the application do not contain relative paths.\n- Disable insecure functions that allow reading of arbitrary files on the server.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "422",
              "name": "Server side template injection",
              "fullDescription": {
                "text": "The application allows injecting malicious entries into a server-side command template. This vulnerability occurs when an attacker can use the template's template syntax to inject a malicious payload into a template, which is then executed on the server side.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/422",
              "help": {
                "text": "Properly sanitize user-controlled inputs. Encourage the use of sandboxing.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "079",
              "name": "Non-upgradable dependencies",
              "fullDescription": {
                "text": "Dependencies are not explicitly declared (name and version) within the source code. They are copied directly into the repositories.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/079",
              "help": {
                "text": "All dependencies must be declared and must referenced with a dependency manager (npm, pip, maven). This allows to standardize projects construction and packaging.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "236",
              "name": "Technical information leak - SourceMap",
              "fullDescription": {
                "text": "The .map files are exposed, making it easy for a malicious actor to analyze the application.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/236",
              "help": {
                "text": "Limit access of map files to authorized users and roles.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "052",
              "name": "Insecure encryption algorithm",
              "fullDescription": {
                "text": "The application uses insecure encryption algorithms.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/052",
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "005",
              "name": "Privilege escalation",
              "fullDescription": {
                "text": "Due to an insecure role configuration, it is possible to obtain administrative access or privileges using a standard user account.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/005",
              "help": {
                "text": "The roles must be controlled with users tokens or the exposure of user ID must be avoided.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "343",
              "name": "Insecure service configuration - BREACH Attack",
              "fullDescription": {
                "text": "The site meets the conditions that make it potentially vulnerable to BREACH attacks:\n- Uses HTTP gzip compression.\n- The information entered by the user is reflected on the site.\n- It stores secrets (session tokens or anti-CSRF).\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/343",
              "help": {
                "text": "Securely configure the vulnerable service so that it can only be accessed by authorized users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "030",
              "name": "Sensitive information sent via URL parameters",
              "fullDescription": {
                "text": "The system sends sensitive information via URL parameters using the GET method. These parameters are:\n- Stored in clear text in the browser history.\n- Sent to external sites via the referrer HTTP header.\n- Sent to external sites via the search bar if the browser interprets the URL as a query.\n- Visible to scripts running on the browser that may belong to third-parties.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/030",
              "help": {
                "text": "Guarantee that the sessions ID are sent through secure methods (POST) or obtain the cookies session.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "135",
              "name": "Insecure or unset HTTP headers - X-XSS Protection",
              "fullDescription": {
                "text": "The application uses the X-XSS Protection header considered deprecated. The use of this header may lead to stored XSS vulnerabilities.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/135",
              "help": {
                "text": "Disable the X-XSS Protection filter in the server responses. Instead, define security policies using CSP Header.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "111",
              "name": "Out-of-bounds read",
              "fullDescription": {
                "text": "It is possible to make the system read data before or beyond the intended buffer.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/111",
              "help": {
                "text": "- Implement good security practices in the software development life cycle.\n- Disable de unsafe functions in the system.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "085",
              "name": "Sensitive data stored in client-side storage",
              "fullDescription": {
                "text": "The application stores sensitive information in the client-side storage (localStorage or sessionStorage). This exposes the information to unauthorized read operations.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/085",
              "help": {
                "text": "Do not use the client side storage to store sensitive information, use cookies instead by defining their respective security attributes.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "107",
              "name": "LDAP injection",
              "fullDescription": {
                "text": "The system builds LDAP queries using untrusted data that could modify the query.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/107",
              "help": {
                "text": "- Avoid using untrusted data to generate dynamic LDAP queries.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "073",
              "name": "Improper authorization control for web services - RDS",
              "fullDescription": {
                "text": "Some RDS instances can be publicly accessible, which can compromise the stored information.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/073",
              "help": {
                "text": "Ensure that the relational databases are accesible only by users and roles authenticated and authorized.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "148",
              "name": "Use of an insecure channel - FTP",
              "fullDescription": {
                "text": "Customer information is transmitted over a channel that does not use encryption, so credentials and confidential information can be captured in plain text.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/148",
              "help": {
                "text": "Deploy the application over an encrypted communication channel, such as SFTP.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "188",
              "name": "Lack of data validation - Modify DOM Elements",
              "fullDescription": {
                "text": "The application allows the creation of dynamic DOM (Document Object Model) elements from user controlled inputs. In addition to being functionally expensive, this operation can lead to the creation and exploitation of other vulnerabilities such as buffer overflow or memory corruption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/188",
              "help": {
                "text": "Avoid generating dynamic DOM from user controlled inputs\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "258",
              "name": "Lack of protection against deletion - ELB",
              "fullDescription": {
                "text": "The current configuration of Elastic Load Balancing has no Deletion Protection safety feature enabled.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/258",
              "help": {
                "text": "Check the Deletion Protection configuration attribute value inside attributes section and enable it.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "396",
              "name": "Insecure service configuration - KMS",
              "fullDescription": {
                "text": "The automatic key rotation for the KMS service is disabled. By keeping static keys during long periods the chances to compromise a valid key are higher.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/396",
              "help": {
                "text": "Enable the automatic key rotation for all the service keys.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "020",
              "name": "Non-encrypted confidential information",
              "fullDescription": {
                "text": "Confidential information, such as payment card data, database records, files on local/mobile storage, backups/snapshots, or cloud resources (e.g., S3, EFS, EBS, DynamoDB, RedShift), is stored or transported without adequate encryption, is encoded (e.g., Base64, hex) instead of encrypted, or is encrypted using a shared/default key instead of a customer-managed key, allowing an attacker with access to the storage, network, or affected resource to view it in plain text.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/020",
              "help": {
                "text": "- Use AES-256 for data at rest and enforce TLS 1.2 or higher (preferably TLS 1.3) for data in transit, including backups and snapshots. Manage encryption keys through a dedicated KMS or HSM, using customer-managed keys (CMKs) rather than provider-default keys where the platform offers that option (e.g., AWS EFS, DynamoDB). On mobile, use the platform's secure storage (iOS Keychain, Android Keystore) instead of local/shared storage.\n- Encoding (e.g., Base64, hex) is not encryption and provides no confidentiality; do not rely on it as a substitute.\n- Apply masking or tokenization to sensitive fields (e.g., payment card data) where required by applicable standards such as PCI DSS.\n- If the exposure is caused by credentials or secrets hardcoded in source code rather than data at rest, encryption in place is not sufficient: remove the credentials from the codebase, rotate them immediately, purge them from git history, and load them from a secrets manager or environment variables.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "400",
              "name": "Traceability Loss - AWS",
              "fullDescription": {
                "text": "Some AWS services (Such as EC2, ELB or S3) do not correctly set the logging property, which avoids the recording of log files. These files are useful to identify and trace malicious actions or anomalous behaviors. Alternatively, the log files do not have enough detail level.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/400",
              "help": {
                "text": "Set the logging property in AWS instances that could handle important data.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "003",
              "name": "Symmetric denial of service",
              "fullDescription": {
                "text": "The server is rendered unresponsive by successively repeating a request which consumes a lot of resources or takes too long to be processed.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/003",
              "help": {
                "text": "Define a time-out when a query or a search is taking a lot of time processing the information\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "318",
              "name": "Insecurely generated token - Validation",
              "fullDescription": {
                "text": "The system does not properly validate the token used for user creation. For this reason, it is possible to modify the header defining the algorithm with which the token is encrypted, so that it is not signed.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/318",
              "help": {
                "text": "Avoid validating the token by taking the algorithm found in the token header, since an attacker could modify it, so that the token signature is not properly validated.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "405",
              "name": "Excessive privileges - Access Mode",
              "fullDescription": {
                "text": "The system files or directories have an access mode too permissive\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/405",
              "help": {
                "text": "System files and directories must be restricted by a custom permission mask, for example an access mode 0600\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "164",
              "name": "Insecure service configuration",
              "fullDescription": {
                "text": "No requestValidationMode is assigned in the server configuration files, which would allow XSS attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/164",
              "help": {
                "text": "Activate the recommended protection mechanisms as Request validation.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "416",
              "name": "XAML injection",
              "fullDescription": {
                "text": "The application does not properly validate user input, allowing XamlReader instances to be manipulated to generate malicious elements that can interact with other system actors\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/416",
              "help": {
                "text": "Define length and content validations in all the system inputs\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "031",
              "name": "Excessive privileges - AWS",
              "fullDescription": {
                "text": "The application, a user or a role have more privileges than they require. This can be leveraged by an attacker to execute normally restricted actions on a system.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/031",
              "help": {
                "text": "Explicitly assign permissions to the appropriate groups and roles following the principle of least privilege.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "034",
              "name": "Insecure generation of random numbers",
              "fullDescription": {
                "text": "The system uses insecure functions, insufficient ranges or low-entropy components to generate random numbers. This could allow an attacker to guess the generation sequence after a short time or predict results using probabilistic methods.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/034",
              "help": {
                "text": "Use the most secure mechanisms offered by language to generate random numbers.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "015",
              "name": "Insecure authentication method - Basic",
              "fullDescription": {
                "text": "The server uses Basic authentication over an insecure channel.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/015",
              "help": {
                "text": "Use stronger authentication mechanisms like Bearer and OAuth.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "136",
              "name": "Insecure or unset HTTP headers - Cache Control",
              "fullDescription": {
                "text": "The application lacks the Cache Control security header or sets the header in a insecure value.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/136",
              "help": {
                "text": "Set the Cache Control header in the server responses using a secure value such as no-store , no-cache and must-revalidate.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "168",
              "name": "Insecure service configuration - Keystore",
              "fullDescription": {
                "text": "Cryptographic key containers such as keystores should have good security practices, among them:\n- The Secretkey and Keystore should be in protected environments.\n- The secrets should be aligned with strong password policies (do not use default passwords).\n- The Secretkey should not be stored in the source code.\n- Passwords to access the Keystore should not be the same as the private password.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/168",
              "help": {
                "text": "Implement good security practices against Keystore containers.\n- Do not store secrets in the source code.\n- Change default passwords.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "169",
              "name": "Insecure service configuration - Keys",
              "fullDescription": {
                "text": "The source code repository stores cipher keys directly. Allowing an attacker with access to the source code to compromise the keys to impersonate the application or decrypt the communications between server and client.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/169",
              "help": {
                "text": "Store the cipher keys in a secured Keystore.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "338",
              "name": "Insecure service configuration - Salt",
              "fullDescription": {
                "text": "Salt is generated in an insecure way, which makes the password easier to guess.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/338",
              "help": {
                "text": "Generate the Salt with a secure hashing function.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "401",
              "name": "Insecure service configuration - AKV Secret Expiration",
              "fullDescription": {
                "text": "The secrets stored in Azure Key Vault do not set an expiration date.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/401",
              "help": {
                "text": "Define an expiration date for Azure secrets by setting the expiration_date property.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "165",
              "name": "Insecure service configuration - AWS",
              "fullDescription": {
                "text": "Because of a misconfiguration in the AWS services, it is possible to identify and/or try to access resources, functionalities, network segments and ports.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/165",
              "help": {
                "text": "Securely configure the vulnerable service to be accessed only by authorized users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "421",
              "name": "Insecure encryption algorithm - Insecure Elliptic Curve",
              "fullDescription": {
                "text": "The system makes use of weak elliptic curves.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/421",
              "help": {
                "text": "Ensure that the curves used are safe for both ECDLP and ECC in general.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "372",
              "name": "Use of an insecure channel - HTTP",
              "fullDescription": {
                "text": "Client information is transmitted over port 80 or HTTP, a channel that does not use encryption, so credentials and confidential information can be captured in plain text.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/372",
              "help": {
                "text": "Deploy the application over the HTTPS secure channel using TLS.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "142",
              "name": "Sensitive information in source code - API Key",
              "fullDescription": {
                "text": "The encryption key is stored in the source code in plain text and is not obtained from a secure source that guarantees its confidentiality.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/142",
              "help": {
                "text": "It is recommended to load encryption keys from:\n- A key vault service.\n- A configuration file that is properly encrypted.\n- Administrative environment variables.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "239",
              "name": "Technical information leak - Errors",
              "fullDescription": {
                "text": "It is possible to cause the server to throw errors after analyzing the endpoints with different techniques such as: sending massive requests to the endpoint, sending massive characters in the body of the application.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/239",
              "help": {
                "text": "Use generic messages to indicate server errors and avoid sending technical information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "235",
              "name": "Technical information leak - Headers",
              "fullDescription": {
                "text": "It is possible to obtain technical information such as technology names or component versions through the server response headers.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/235",
              "help": {
                "text": "Verify that HTTP response headers do not contain any name or version.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "014",
              "name": "Insecure functionality",
              "fullDescription": {
                "text": "A functionality that is part of the system can be leveraged by an attacker in order to negatively impact it.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/014",
              "help": {
                "text": "Validate on the server side that the answers to the questions are correct.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "007",
              "name": "Cross-site request forgery",
              "fullDescription": {
                "text": "The applications configuration allows an attacker to trick authenticated users into executing actions without their consent.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/007",
              "help": {
                "text": "Use of tokens in forms to verify requests done by legitimate users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "038",
              "name": "Business information leak",
              "fullDescription": {
                "text": "It is possible to obtain business information, such as:\n- Username list\n- Strategic information\n- Employees information\n- Clients information\n- Providers information\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/038",
              "help": {
                "text": "Based on the classification of the information found, set the necessary controls to guarantee that information is accessible only to right users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "029",
              "name": "Inadequate file size control",
              "fullDescription": {
                "text": "The system does not perform an adequate control of the size of the files that can be uploaded to the server.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/029",
              "help": {
                "text": "Implement controls to limit the maximum file size that can be uploaded to the server.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "418",
              "name": "Insecure service configuration - Docker",
              "fullDescription": {
                "text": "Using the ADD command to automatically extract files to the destination directory adds the risk of exploiting vulnerabilities such as zip bombs and Zip Slip that could then be activated automatically.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/418",
              "help": {
                "text": "Avoid the use of the ADD command unless you need extract a local tar file. Instead, use the COPY command\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "086",
              "name": "Missing subresource integrity check",
              "fullDescription": {
                "text": "The application does not properly check the integrity of resources loaded from third-party servers.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/086",
              "help": {
                "text": "Add the integrity attribute to HTML script tags.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "264",
              "name": "Insecure encryption algorithm - TripleDES",
              "fullDescription": {
                "text": "The server where the application is stored supports insecurely configured ciphers, in addition to the ECB mode considered insecure:\n- Data Encryption Standard (DES).\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/264",
              "help": {
                "text": "Use a secure encryption algorithm.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "281",
              "name": "Use of an insecure channel - Cloud Infrastructure",
              "fullDescription": {
                "text": "Insecure communications medium and channels require application data protection in transit.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/281",
              "help": {
                "text": "- Enable secure cipher suites and encryption protocols.\n- Encryption and data integrity authentication are important for protecting the communications channel.\n- It is equally important to authenticate the identity of the remote end of the connection.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "094",
              "name": "Insecure encryption algorithm - Cipher Block Chaining",
              "fullDescription": {
                "text": "The application uses algorithms with insecure cipher block chaining.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/094",
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            }
          ]
        }
      },
