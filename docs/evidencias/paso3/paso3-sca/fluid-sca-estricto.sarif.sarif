{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.4.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Fluid Attacks SCA",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "274",
              "name": "Restricted fields manipulation",
              "fullDescription": {
                "text": "From the self-management functionality for the registration of an employee, it is possible to change the information of other employees from other companies. An attacker can initiate a request to confirm the registration of an employee and change the DNI to different values so that it replaces the existing data. In this way the information sent will be stored in the company, updating all the information of the targeted employees such as names, e-mail addresses, dates of birth, addresses, telephone numbers, among others.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/274",
              "help": {
                "text": "Verify that the user who is trying to modify the information has the necessary permissions to access.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "009",
              "name": "Sensitive information in source code",
              "fullDescription": {
                "text": "The source code repository contains sensitive information such as usernames, passwords, email addresses and IP addresses, among others. Alternatively, while values may be password=123 o aws.secret_key=test, they reveal the bad practice of storing sensitive information in the repository with no encryption, and sooner or later they can be replaced for real sensitive values.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/009",
              "help": {
                "text": "- Delete all hardcoded sensitive information.\n- Change all affected access credentials.\n- Remove sensitive information from git logs.\n- Load sensitive data from safe sources such as, key vault services, configuration files properly encrypted or administrative environment variables.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "115",
              "name": "Security controls bypass or absence",
              "fullDescription": {
                "text": "The system has security controls that can be bypassed.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/115",
              "help": {
                "text": "Limit the number of requests that can be made by the same host in defined time slots.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "096",
              "name": "Insecure deserialization",
              "fullDescription": {
                "text": "The system deserializes objects without first validating their content nor casting them to a specific type.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/096",
              "help": {
                "text": "Validate the incoming serialized objects and only deserialize them if they meet expected properties.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "111",
              "name": "Out-of-bounds read",
              "fullDescription": {
                "text": "It is possible to make the system read data before or beyond the intended buffer.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/111",
              "help": {
                "text": "- Implement good security practices in the software development life cycle.\n- Disable de unsafe functions in the system.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "164",
              "name": "Insecure service configuration",
              "fullDescription": {
                "text": "No requestValidationMode is assigned in the server configuration files, which would allow XSS attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/164",
              "help": {
                "text": "Activate the recommended protection mechanisms as Request validation.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "188",
              "name": "Lack of data validation - Modify DOM Elements",
              "fullDescription": {
                "text": "The application allows the creation of dynamic DOM (Document Object Model) elements from user controlled inputs. In addition to being functionally expensive, this operation can lead to the creation and exploitation of other vulnerabilities such as buffer overflow or memory corruption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/188",
              "help": {
                "text": "Avoid generating dynamic DOM from user controlled inputs\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "163",
              "name": "Insecure digital certificates",
              "fullDescription": {
                "text": "The apk certificate was signed using the SHA1 algorithm. This algorithm is considered quite insecure, so it should not be used to sign certificates since it can be reversed in order to obtain the signing key. On the other hand, there are URLs that, just by accessing them, it is possible to download the digital certificates stored in them, thus exposing confidential information of the organization.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/163",
              "help": {
                "text": "Sign the certificate with SHA2 or higher.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "431",
              "name": "Supply Chain Attack - Lock Files",
              "fullDescription": {
                "text": "A lock file has not been defined to validate the integrity of the software to be used. This can lead to a supply chain attack if the software is compromised, such as by injecting malware.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/431",
              "help": {
                "text": "Set the version numbers in your administrator file and make use of the lock file where the complete software tree used by the project is defined and where it has integrity data defined for each software used.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "086",
              "name": "Missing subresource integrity check",
              "fullDescription": {
                "text": "The application does not properly check the integrity of resources loaded from third-party servers.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/086",
              "help": {
                "text": "Add the integrity attribute to HTML script tags.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "038",
              "name": "Business information leak",
              "fullDescription": {
                "text": "It is possible to obtain business information, such as:\n- Username list\n- Strategic information\n- Employees information\n- Clients information\n- Providers information\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/038",
              "help": {
                "text": "Based on the classification of the information found, set the necessary controls to guarantee that information is accessible only to right users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "126",
              "name": "Lack of isolation methods",
              "fullDescription": {
                "text": "The system do not use isolation methods for running applications.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/126",
              "help": {
                "text": "- Use dedicated cloud servers rather than VMs or cloud-based containers.\n- Implement specific isolation strategies, particularly between hosts and the network.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "416",
              "name": "XAML injection",
              "fullDescription": {
                "text": "The application does not properly validate user input, allowing XamlReader instances to be manipulated to generate malicious elements that can interact with other system actors\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/416",
              "help": {
                "text": "Define length and content validations in all the system inputs\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "087",
              "name": "Account lockout",
              "fullDescription": {
                "text": "It is possible to cause account lockouts, effectively blocking users from accessing the system.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/087",
              "help": {
                "text": "Avoid blocking users accounts as a mechanism of protection, make it more restrictive or control it to prevent an exploitation by attackers.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "308",
              "name": "Enabled default configuration",
              "fullDescription": {
                "text": "The servers default page is enabled, which allows an attacker to access it and obtain relevant technical information about the server.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/308",
              "help": {
                "text": "Disable or modify the servers default page in such a way that no information can be obtained from it.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "310",
              "name": "Unauthorized access to screen",
              "fullDescription": {
                "text": "An advisor, through the GLIA application, should not have access to client information. However, the advisor can obtain different client data (without the client being aware of it), simply by logging into the user window and following the flow that the user goes through when opening an account.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/310",
              "help": {
                "text": "User information should not be exposed to a third party in any part of the account opening flow.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "059",
              "name": "Sensitive information stored in logs",
              "fullDescription": {
                "text": "The system stores sensitive information such as credentials, bank accounts and file paths in log files.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/059",
              "help": {
                "text": "Verify that the information stored in logs is not sensitive.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "020",
              "name": "Non-encrypted confidential information",
              "fullDescription": {
                "text": "Confidential information, such as payment card data, database records, files on local/mobile storage, backups/snapshots, or cloud resources (e.g., S3, EFS, EBS, DynamoDB, RedShift), is stored or transported without adequate encryption, is encoded (e.g., Base64, hex) instead of encrypted, or is encrypted using a shared/default key instead of a customer-managed key, allowing an attacker with access to the storage, network, or affected resource to view it in plain text.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/020",
              "help": {
                "text": "- Use AES-256 for data at rest and enforce TLS 1.2 or higher (preferably TLS 1.3) for data in transit, including backups and snapshots. Manage encryption keys through a dedicated KMS or HSM, using customer-managed keys (CMKs) rather than provider-default keys where the platform offers that option (e.g., AWS EFS, DynamoDB). On mobile, use the platform's secure storage (iOS Keychain, Android Keystore) instead of local/shared storage.\n- Encoding (e.g., Base64, hex) is not encryption and provides no confidentiality; do not rely on it as a substitute.\n- Apply masking or tokenization to sensitive fields (e.g., payment card data) where required by applicable standards such as PCI DSS.\n- If the exposure is caused by credentials or secrets hardcoded in source code rather than data at rest, encryption in place is not sufficient: remove the credentials from the codebase, rotate them immediately, purge them from git history, and load them from a secrets manager or environment variables.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "014",
              "name": "Insecure functionality",
              "fullDescription": {
                "text": "A functionality that is part of the system can be leveraged by an attacker in order to negatively impact it.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/014",
              "help": {
                "text": "Validate on the server side that the answers to the questions are correct.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "448",
              "name": "Use of software with malware",
              "fullDescription": {
                "text": "One or more dependencies used in the project contains code or components suspected of being compromised by malware or malicious behavior.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/448",
              "help": {
                "text": "- Review the origin and integrity of affected dependencies. - Upgrade to secure versions or alternatives without known risks. - Perform security audits and code analysis for vulnerabilities. - Perform additional testing to verify that there are no compromises in the production environment.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "134",
              "name": "Insecure or unset HTTP headers - CORS",
              "fullDescription": {
                "text": "The cross-domain policy includes wildcards, accepting any domain as valid for sharing resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/134",
              "help": {
                "text": "Remove the wildcard (*) and define explicitly the trusted origins for the application resources.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "124",
              "name": "Race condition",
              "fullDescription": {
                "text": "The system presents unexpected behavior when the inputs of a specific functionality do not arrive in the expected order.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/124",
              "help": {
                "text": "Ensure that the verification and use of inputs must be realized at the same time or in an atomic way.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "108",
              "name": "Improper control of interaction frequency",
              "fullDescription": {
                "text": "The system does not limit the amount of requests (rate limit) that a user can post to the server in a short period of time.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/108",
              "help": {
                "text": "Limit the number of requests that can be made by the same host in defined time slots.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "360",
              "name": "Clickjacking",
              "fullDescription": {
                "text": "The application can be embedded in malicious iframes allowing an attacker to hijack the user clicks to perform actions without the user consent.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/360",
              "help": {
                "text": "Set the frame-ancestors policy in the Content Security Policy using a secure configuration.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "201",
              "name": "Unauthorized access to files",
              "fullDescription": {
                "text": "In the functionality corresponding to update user data, it is possible to inject potentially dangerous characters that generate inappropriate behavior in the application, exposing the access to Sharepoint and allowing the user to access functionalities and files without authorization.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/201",
              "help": {
                "text": "Validate on the server side the types of data that are entered into different types of fields in the application. Restrict file access to authenticated and authorized users only.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "183",
              "name": "Debugging enabled in production",
              "fullDescription": {
                "text": "The system has the debug mode active which generates an information leak when an error is generated.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/183",
              "help": {
                "text": "Make sure that debugging mode is not enabled in the production environment and remove statements or portions of code that are executing in debugging mode.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "026",
              "name": "User enumeration",
              "fullDescription": {
                "text": "The system provides different responses for existent and non-existent users, allowing an attacker to enumerate valid users via error messages, response times, frames count, among other techniques.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/026",
              "help": {
                "text": "Set the same server response for existent and non-existent users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "033",
              "name": "Password change without identity check",
              "fullDescription": {
                "text": "The system allows a user to change their password without requesting the previous one or enforcing another identity verification mechanism.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/033",
              "help": {
                "text": "- Guarantee that the current password is needed when a password change is requested by users.\n- Use a second authentication mechanism to ensure the password change is performed by the account owner.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "065",
              "name": "Cached form fields",
              "fullDescription": {
                "text": "The application does not disable caching of input fields, thus the information will be stored in the browser's cache.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/065",
              "help": {
                "text": "The data cache to browsers level must be disabled using some of these methods:\n- Use HTTP control headers that prevent cache.\n- Use meta-tags in HTML pages.\n- Disable the autocomplete field to prevent cache to fields level.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "289",
              "name": "Technical information leak - Logs",
              "fullDescription": {
                "text": "The application has an HTML file that displays a LOG of the system. In the event that this page is accessible by users, they will be able to know information about the system.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/289",
              "help": {
                "text": "Avoid exposing system information in files that can be accessed by third parties.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "029",
              "name": "Inadequate file size control",
              "fullDescription": {
                "text": "The system does not perform an adequate control of the size of the files that can be uploaded to the server.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/029",
              "help": {
                "text": "Implement controls to limit the maximum file size that can be uploaded to the server.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "013",
              "name": "Insecure object reference",
              "fullDescription": {
                "text": "The systems authorization mechanism does not prevent one user from accessing another users data by modifying the key value that identifies it.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/013",
              "help": {
                "text": "- Validate that unprivileged users can access and modify only their own information.\n- Handle the user operations using session objects.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "032",
              "name": "Spoofing",
              "fullDescription": {
                "text": "It is possible to perform actions in the application and make it look as if they were performed by the system or another user. Examples include sending messages that appear to come from the system and modifying data in the name of other users (who may have more privileges).\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/032",
              "help": {
                "text": "Avoid the usage of custom system messages that can be tampered by an user.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "211",
              "name": "Asymmetric denial of service - ReDoS",
              "fullDescription": {
                "text": "Within the source code there is evidence of the use of dangerous regular expressions, because they make use of complex operations to find matches, which can lead to an attacker sending a specific string of data that could cause the server to crash when evaluating the string with the dangerous regular expression.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/211",
              "help": {
                "text": "Use optimized regular expressions to perform functions without much computational overhead.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "068",
              "name": "Insecure session expiration time",
              "fullDescription": {
                "text": "User sessions do not expire after 5 minutes of inactivity.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/068",
              "help": {
                "text": "Close the sessions when they remain inactive more than 5 minutes.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "417",
              "name": "Account Takeover",
              "fullDescription": {
                "text": "By exploiting one or several application vulnerabilities it is possible to take control over a user account and perform action on his behalf\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/417",
              "help": {
                "text": "Define account recovery mechanisms, validating that the requester is the account owner.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "034",
              "name": "Insecure generation of random numbers",
              "fullDescription": {
                "text": "The system uses insecure functions, insufficient ranges or low-entropy components to generate random numbers. This could allow an attacker to guess the generation sequence after a short time or predict results using probabilistic methods.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/034",
              "help": {
                "text": "Use the most secure mechanisms offered by language to generate random numbers.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "017",
              "name": "Sensitive information sent insecurely",
              "fullDescription": {
                "text": "Sensitive information, such as session identifiers, is sent through channels or methods that do not guarantee its confidentiality, including unencrypted connections or URL query parameters.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/017",
              "help": {
                "text": "- Transmit sensitive information only over encrypted channels, such as HTTPS with TLS 1.2 or higher.\n- Do not place session identifiers or other sensitive data in URL query parameters; use the request body, secure cookies, or headers instead, since encryption alone does not prevent their exposure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "039",
              "name": "Improper authorization control for web services",
              "fullDescription": {
                "text": "The systems web services do not have an authorization control mechanism or the one in place can be bypassed.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/039",
              "help": {
                "text": "Validate through session cookies or tokens that users trying to access certain information are authenticated.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "056",
              "name": "Anonymous connection",
              "fullDescription": {
                "text": "Due to an improper configuration of the server (e.g., an FTP service with username: anonymous and password: guest or an SMTP open relay), it is possible to make anonymous connections to it and access otherwise protected resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/056",
              "help": {
                "text": "Configure the services to avoid services enumeration or to connect to these anonymously.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "044",
              "name": "Insecure HTTP methods enabled",
              "fullDescription": {
                "text": "HTTP methods such as TRACE, PUT and DELETE are enabled on the server. These methods may allow an attacker to include and/or delete files, or perform cross-site tracing attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/044",
              "help": {
                "text": "Configure secure methods for servers requests.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "106",
              "name": "NoSQL injection",
              "fullDescription": {
                "text": "The system generates NoSQL queries dynamically and without validating untrusted inputs.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/106",
              "help": {
                "text": "Validate and escape data that will be included in sentences generated dynamically.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "100",
              "name": "Server-side request forgery (SSRF)",
              "fullDescription": {
                "text": "It is possible to induce the application's server into making requests to an arbitrary domain.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/100",
              "help": {
                "text": "The system must avoid that the information query from the server be controlled by users. If this is necessary, the system must restrict the endpoints accepted for query.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "324",
              "name": "Insecure functionality - User management",
              "fullDescription": {
                "text": "It is possible to assign non-users as treatment managers of vulnerabilities, this will send an email with the information of the vulnerabilities even if the email is not registered on integrates. Even if the user has been removed from all the projects of an organization, the information of the vulnerabilities over the time and the policies is still accessible by the email.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/324",
              "help": {
                "text": "Grant access to the projects only to users that have consented the reception of information from the application. Disable all users from the organizations if they should not have access to any project. Verify that only authorized users have access to information and actions on the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "069",
              "name": "Weak CAPTCHA",
              "fullDescription": {
                "text": "The system uses an insecure CAPTCHA implementation that allows the usage of optical recognition tools to automatically pass it.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/069",
              "help": {
                "text": "Ensure that captchas response is at servers level and is not exposed on the HTML web pages code, also, ensure that captcha can not be read by an OCR.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "313",
              "name": "Insecure service configuration - Certificates",
              "fullDescription": {
                "text": "Due to a misconfiguration of X.509 certificates, the application can accept invalid certificates, making it possible to carry out Man in The Middle attacks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/313",
              "help": {
                "text": "Throw typed exceptions in case of detection of invalid certificates.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "083",
              "name": "XML injection (XXE)",
              "fullDescription": {
                "text": "It is possible to inject XML code into the application's requests, which is then interpreted by the server. This could allow an attacker to perform data exfiltration or execute commands remotely.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/083",
              "help": {
                "text": "Filter the information that is received and sent by the application through white lists.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "097",
              "name": "Reverse tabnabbing",
              "fullDescription": {
                "text": "The system allows the introduction of a link to an external site controlled by a malicious actor. This site can then redirect the user to a different site in the original tab, making it look like a legitimate redirect performed by the system.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/097",
              "help": {
                "text": "Set the attribute rel with the noopener and noreferrer value in each external link.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "325",
              "name": "Excessive privileges - Wildcards",
              "fullDescription": {
                "text": "- Privileges are granted with wildcard (*) in critical actions.\n- Many roles have unnecessary privileges over IAM.\n- Some write actions allow the use of Wildcards(*).\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/325",
              "help": {
                "text": "Grant privileges strictly to the roles that need it.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "117",
              "name": "Unverifiable files",
              "fullDescription": {
                "text": "Files are stored in the repository that cannot be verified because their content is not compatible with their extension.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/117",
              "help": {
                "text": "- Remove the files that should not be versioned from the repository.\n- Include the affected extensions in the .gitignore file.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "098",
              "name": "External control of file name or path",
              "fullDescription": {
                "text": "It is possible to modify the path to which an uploaded file will be saved.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/098",
              "help": {
                "text": "Validate uploaded files names on the system and restrict the storage to destined folders only.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "037",
              "name": "Technical information leak",
              "fullDescription": {
                "text": "The application or its underlying components expose technical details that aid an attacker in reconnaissance, such as:\n- Component names, versions, or configuration details, exposed through response headers, service banners, configuration files, or framework-specific markers.\n- Internal network information, such as internal IP addresses, exposed in responses.\n- Debug or diagnostic output, such as console logging or alert functions, left enabled in production code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/037",
              "help": {
                "text": "- Remove service banners, HTTP headers, and framework-specific markers that reveal component names or versions.\n- Restrict access to configuration files and internal network details such as IP addresses.\n- Disable or remove debug and diagnostic output, such as console logging or alert functions, in production environments; log errors through a protected logging mechanism instead.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "008",
              "name": "Reflected cross-site scripting (XSS)",
              "fullDescription": {
                "text": "The web application dynamically generates web content without validating the source of the potentially untrusted data.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/008",
              "help": {
                "text": "Perform input data validations on the server-side to avoid common script injection attacks.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "200",
              "name": "Traceability loss",
              "fullDescription": {
                "text": "Some features of the application do not properly keep track of errors, exceptional events or critical actions on the system, hidering the detection of possible security events.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/200",
              "help": {
                "text": "Set alerts for errors, events and critical actions using the mechanisms available by the technology stack.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "004",
              "name": "Remote command execution",
              "fullDescription": {
                "text": "The system builds OS commands using inputs that can be manipulated externally, it does not correctly neutralize special elements that could modify the OS command.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/004",
              "help": {
                "text": "- If at all possible, use standard library calls rather than external processes to recreate the desired functionality.\n- Keep as much data as possible used to generate command outside of external control.\n- Properly escape the arguments used to generate the command and avoid special characters.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "136",
              "name": "Insecure or unset HTTP headers - Cache Control",
              "fullDescription": {
                "text": "The application lacks the Cache Control security header or sets the header in a insecure value.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/136",
              "help": {
                "text": "Set the Cache Control header in the server responses using a secure value such as no-store , no-cache and must-revalidate.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "146",
              "name": "SQL injection",
              "fullDescription": {
                "text": "Dynamic SQL statements are built by concatenating untrusted input (from query parameters, HTTP headers, or other request fields) without the required data validation and without using parameterized statements, prepared statements, or stored procedures free of internal concatenation. This also includes ORM-based query languages (e.g., JPQL, HQL), expression bindings (e.g., SpEL) that evaluate attacker-controlled values as part of the query, and dynamic identifiers (table names, column names, sort order) built from untrusted input, which parameterized statements alone cannot protect.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/146",
              "help": {
                "text": "- Perform database queries through parameterized statements or prepared statements instead of string concatenation. A stored procedure is only safe if it does not itself build dynamic SQL by concatenating its parameters (e.g., via 'sp_executesql' or 'EXEC'); used that way, it is just as injectable as inline concatenation.\n- Parameters cannot be used for dynamic identifiers (table names, column names, 'ORDER BY' direction); validate these against a strict allow-list of expected values instead.\n- When using LIKE-conditions with user-supplied values, sanitize wildcard characters explicitly (e.g., using the escape(String) function); parameterization alone does not prevent wildcard injection in LIKE clauses.\n- Run database queries with a least-privilege account scoped to only the operations and tables the application needs, to limit the impact of any injection that does occur.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "184",
              "name": "Lack of data validation",
              "fullDescription": {
                "text": "The application does not control the the server side where you have permission to modify certain fields and allows the use of invalid data in some fields, for example, an ID composed of only letters.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/184",
              "help": {
                "text": "Validate on the server side the data types that are entered into different kind of fields in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "035",
              "name": "Weak credential policy",
              "fullDescription": {
                "text": "The application's credential policy does not enforce the technical parameters required to resist guessing attacks: it allows passwords or passphrases below the recommended minimum length (or caps them below the recommended maximum), does not reject weak, word-based, previously breached, or context-specific credentials (e.g., username, app name), issues temporary passwords or OTPs (e.g., for account recovery, first login, or MFA) that are short-lived or short in name only, without sufficient entropy or length, and/or allows credentials to be shared or reused across multiple users or accounts.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/035",
              "help": {
                "text": "- Require passphrases of at least four words or passwords of at least 20 characters, rather than short, word-based passwords, and do not impose an arbitrarily low maximum length that would reject strong passphrases.\n- Reject passwords found in known breach databases (e.g., via the HaveIBeenPwned API) and passwords built from context-specific words (e.g., username, service name) at creation and change time.\n- Generate temporary passwords and OTPs (recovery, first login, MFA, admin-issued) with sufficient entropy (temporary passwords: minimum 12 characters, mixed case, digits, and symbols; OTPs: minimum 6 digits) and force expiry after first use or within a short window (e.g., 15 minutes).\n- Require each user or system to have a unique, non-shared credential; reusing or sharing credentials across accounts prevents individual accountability and multiplies the impact of a single compromise.\n- Do not enforce arbitrary periodic password expiration without evidence of compromise: per NIST SP 800-63B, mandatory rotation leads users to choose weaker, predictable passwords. Enforce expiration only upon detected compromise, or per an applicable compliance requirement, and require MFA for all privileged accounts.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "156",
              "name": "Uncontrolled external site redirect",
              "fullDescription": {
                "text": "Redirects made by the application are not controlled and could be manipulated by an attacker.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/156",
              "help": {
                "text": "Use predefined parameters and not information that can be manipulated by the user for redirection to web sites in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "123",
              "name": "Local file inclusion",
              "fullDescription": {
                "text": "The application allows to read or execute files located on the server through relative paths manipulation in the input fields.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/123",
              "help": {
                "text": "- Validate that the parameters received by the application do not contain relative paths.\n- Disable insecure functions that allow reading of arbitrary files on the server.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "089",
              "name": "Lack of data validation - Trust boundary violation",
              "fullDescription": {
                "text": "The system mixes trusted and untrusted data in the same data structure or structured message.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/089",
              "help": {
                "text": "- Prevent the use of untrusted data in critical data structures or structured messages.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "422",
              "name": "Server side template injection",
              "fullDescription": {
                "text": "The application allows injecting malicious entries into a server-side command template. This vulnerability occurs when an attacker can use the template's template syntax to inject a malicious payload into a template, which is then executed on the server side.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/422",
              "help": {
                "text": "Properly sanitize user-controlled inputs. Encourage the use of sandboxing.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "061",
              "name": "Remote File Inclusion",
              "fullDescription": {
                "text": "The application allows to load and execute malicious files from remote locations. This practice may allow an attacker to retrieve sensitive data from the server or execute commands remotely.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/061",
              "help": {
                "text": "Avoid the usage of dangerous functions such as include, exec, eval, file, readfile among others using non-sanitized data.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "079",
              "name": "Non-upgradable dependencies",
              "fullDescription": {
                "text": "Dependencies are not explicitly declared (name and version) within the source code. They are copied directly into the repositories.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/079",
              "help": {
                "text": "All dependencies must be declared and must referenced with a dependency manager (npm, pip, maven). This allows to standardize projects construction and packaging.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "316",
              "name": "Improper resource allocation - Buffer overflow",
              "fullDescription": {
                "text": "Within the code there are unsafe statements that can affect the performance and response time of the application. See https://rules.sonarsource.com/java/RSPEC-1149?search=stringbuffer for more information.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/316",
              "help": {
                "text": "Use the libraries that allow to execute the functions of concatenation and storage in collections in an optimized way (ArrayList and StringBuilder or SyncronizedList).\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "353",
              "name": "Lack of data validation - Token",
              "fullDescription": {
                "text": "The generated JWT access token does not validate if the signature is valid so the token can be modified and requests are accepted; even removing the signature from the token works.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/353",
              "help": {
                "text": "Generate a token with random components without sensitive information and always validate that the integrity of the token is maintained (signature verification, signature).\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "067",
              "name": "Improper resource allocation",
              "fullDescription": {
                "text": "The system allocates unnecessary resources due to the use of improper programming practices or inefficient algorithms. Alternatively, the allocation can be controlled by an external source (e.g., user input), and hence, requests that consume an enormous amount of resources are processed without any restriction.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/067",
              "help": {
                "text": "Use stable and optimized libraries to perform functions without a large computational expense.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "085",
              "name": "Sensitive data stored in client-side storage",
              "fullDescription": {
                "text": "The application stores sensitive information in the client-side storage (localStorage or sessionStorage). This exposes the information to unauthorized read operations.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/085",
              "help": {
                "text": "Do not use the client side storage to store sensitive information, use cookies instead by defining their respective security attributes.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "390",
              "name": "Prototype Pollution",
              "fullDescription": {
                "text": "An application object, method or module can be overwritten with malicious logic due to the lack of validations and the nature of the JavaScript language.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/390",
              "help": {
                "text": "- Implement integrity validations on the vulnerable objects.\n- Restrict and Discourage the use harmful properties such as _proto_ in the system objects.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "078",
              "name": "Insecurely generated token",
              "fullDescription": {
                "text": "It is possible to crack the token's hash and obtain the information it is masking because it is not generated using a secure cryptographic mechanism.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/078",
              "help": {
                "text": "Generate a token with random components without sensitive information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "021",
              "name": "XPath injection",
              "fullDescription": {
                "text": "Dynamic XPath statements are generated without the required data validation.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/021",
              "help": {
                "text": "Perform input data validations on the server-side to avoid common injection attacks.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "127",
              "name": "Lack of data validation - Type confusion",
              "fullDescription": {
                "text": "A field is interpreted on the server-side, although it indicates that it only accepts numbers, it allows values in the form 0xff.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/127",
              "help": {
                "text": "Validate on the server-side the data types that are entered but prevent them from being interpreted.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "076",
              "name": "Insecure session management",
              "fullDescription": {
                "text": "The session token does not expire when the user terminates the session and can be used to post requests afterwards.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/076",
              "help": {
                "text": "Ensure the expiration of the session token after the user logs out.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "091",
              "name": "Log injection",
              "fullDescription": {
                "text": "The system logs entries that contain input from untrusted sources without properly validating, sanitizing or escaping their content.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/091",
              "help": {
                "text": "Sanitize inputs before storing them in the log.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "028",
              "name": "Insecure temporary files",
              "fullDescription": {
                "text": "The system uses temporary files to store sensitive information. Alternatively, the system deploys sensitive temporary files to the production environment.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/028",
              "help": {
                "text": "Avoid saving sensitive information in server files.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "332",
              "name": "Use of insecure channel - Source code",
              "fullDescription": {
                "text": "Customer information is transmitted over a channel that does not use encryption.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/332",
              "help": {
                "text": "Deploy the application over an encrypted communication channel, e.g. HTTPS using TLS.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "425",
              "name": "Server side cross-site scripting",
              "fullDescription": {
                "text": "It is possible to inject JavaScript into application fields, with the goal of having the server execute malicious code before rendering user input. This allows a remote attacker to compromise internal server files, make requests on behalf of the server or perform a port scan.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/425",
              "help": {
                "text": "Properly sanitize user input, before executing it on the server side.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "042",
              "name": "Insecurely generated cookies",
              "fullDescription": {
                "text": "The system does not set security attributes for sensitive cookies, which could cause them to be sent in plain text or disclosed by unauthorized users on the client side.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/042",
              "help": {
                "text": "The application must set the corresponding security attributes when cookies are generated.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "317",
              "name": "Improper resource allocation - Memory leak",
              "fullDescription": {
                "text": "The system may not be able to release inbound and outbound flow resources that have been opened, because they are not explicitly closed within the source code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/317",
              "help": {
                "text": "Outflows must be explicitly shut down immediately after use.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "119",
              "name": "Metadata with sensitive information",
              "fullDescription": {
                "text": "The system exposes sensitive information through public metadata files.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/119",
              "help": {
                "text": "Delete files metadata before sharing or publishing them.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "081",
              "name": "Lack of multi-factor authentication",
              "fullDescription": {
                "text": "Critical services of the system, such as databases, shared resources containing sensitive information and web services, are not protected by a multi-factor authentication mechanism. This makes it easier for an attacker who has compromised a user's account to access those resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/081",
              "help": {
                "text": "Implement a double factor authentication by software or hardware to increase the protection level of the resources authentication.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "063",
              "name": "Lack of data validation - Path Traversal",
              "fullDescription": {
                "text": "The software uses external input to construct a pathname that is intended to identify a file or directory but it does not properly neutralize or validate special elements within the pathname.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/063",
              "help": {
                "text": "- Prevent the attacker from constructing the pathname.\n- Validate/Neutralize the input for special elements like: .., ~, /.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "005",
              "name": "Privilege escalation",
              "fullDescription": {
                "text": "Due to an insecure role configuration, it is possible to obtain administrative access or privileges using a standard user account.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/005",
              "help": {
                "text": "The roles must be controlled with users tokens or the exposure of user ID must be avoided.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "110",
              "name": "HTTP request smuggling",
              "fullDescription": {
                "text": "The system uses one or more entities, such as a proxy or a firewall, to process requests between the client and the server. These entities do not process HTTP requests consistently, thus making it possible to post malformed requests to get one of the entities to process a request without the other ones noticing it. The reason the entities do not process the requests consistently is that the web server software each one uses delimits requests differently.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/110",
              "help": {
                "text": "Use the same web servers software on the front-end and back-end servers, making the delimiters among the requests coincide each other.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "157",
              "name": "Unrestricted access between network segments",
              "fullDescription": {
                "text": "The current network configuration lacks access restrictions between network segments, which would allow an attacker to access privileged server segments or services from unauthorized networks.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/157",
              "help": {
                "text": "Segment the corporate network using the principle of least privilege necessary to limit access to the database.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "090",
              "name": "CSV injection",
              "fullDescription": {
                "text": "It is possible to inject formulas into fields that are later exported as part of CSV files and can be interpreted by Excel.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/090",
              "help": {
                "text": "Sanitize all the fields that will be exported to the server when the exported file is generated.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "120",
              "name": "Improper dependency pinning",
              "fullDescription": {
                "text": "The application does not make explicit the whole dependency tree it requires (direct and indirect third-party libraries) and their respective version.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/120",
              "help": {
                "text": "All dependencies must be declared with a specific version and must be referenced with a dependency manager (npm, pip, maven). This allows to standardize the projects construction and packaging.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "047",
              "name": "Automatic information enumeration",
              "fullDescription": {
                "text": "It is possible to automatically enumerate system information such as open ports, available services and users personal data.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/047",
              "help": {
                "text": "Filter the information that is received through the ports avoiding the detection of services.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "082",
              "name": "Insecurely deleted files",
              "fullDescription": {
                "text": "It is possible to retrieve deleted files with sensitive information because they were merely sent to the Recycle Bin or removed using insecure protocols.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/082",
              "help": {
                "text": "Good practices must be followed to clean, delete, and destruction of sensitive information (Policies).\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "340",
              "name": "Lack of data validation - Special Characters",
              "fullDescription": {
                "text": "The system does not validate that special characters are not entered in some fields.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/340",
              "help": {
                "text": "Validate in all fields that no special characters are entered.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "006",
              "name": "Authentication mechanism absence or evasion",
              "fullDescription": {
                "text": "The system lacks an authentication mechanism or has one that can be bypassed. Therefore, an attacker can access resources that should be protected without having an active session.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/006",
              "help": {
                "text": "Each critical functionality resource for the organization must have a strong authentication process and it needs to be assured that each user trying to access has an initialized session.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "159",
              "name": "Excessive privileges",
              "fullDescription": {
                "text": "A user with access to the application can generate an error within the application to gain access to the SharePoint platform. From which they can create groups with excessive privileges, to use functions that were not possible to access initially. Also, they can modify or remove permissions that other users or groups have on the application and share content with users who initially did not have access.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/159",
              "help": {
                "text": "Configure the application so that users cannot modify their permissions.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "053",
              "name": "Lack of protection against brute force attacks",
              "fullDescription": {
                "text": "The system does not have appropriate protection mechanisms against automated attacks designed to guess credentials.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/053",
              "help": {
                "text": "Implement a control to avoid this type of attacks and to ensure that access is not made by a robot. E.g. Captcha, failed attempts blockout, etc.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "060",
              "name": "Insecure service configuration - Host verification",
              "fullDescription": {
                "text": "The system does not properly restrict incoming connections from unknown external hosts.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/060",
              "help": {
                "text": "Validate that incoming connections come from trusted hosts already defined in the known_hosts file.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "107",
              "name": "LDAP injection",
              "fullDescription": {
                "text": "The system builds LDAP queries using untrusted data that could modify the query.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/107",
              "help": {
                "text": "- Avoid using untrusted data to generate dynamic LDAP queries.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "027",
              "name": "Insecure file upload",
              "fullDescription": {
                "text": "The system allows the upload of files with two extensions or with unsafe ones, such as .html, .php or .exe. Furthermore, the system does not validate whether or not the file is free from malicious code.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/027",
              "help": {
                "text": "- Validate with regular expressions that the file has only one extension.\n- Validate with an antivirus software that the file does not contain any type of malicious code.\n- Validate that Content Type corresponds to the files extension before upload it to the server.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "052",
              "name": "Insecure encryption algorithm",
              "fullDescription": {
                "text": "The application uses insecure encryption algorithms.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/052",
              "help": {
                "text": "Use algorithms considered cryptographically secure.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "404",
              "name": "OS Command Injection",
              "fullDescription": {
                "text": "The application allows the execution of functions or methods which execute commands in the system with non-sanitized parameters. This action would allow an attacker to inject malicious commands in the server to highly increase the attack vectors by escalating privileges, obtaining or modifying sensitive information stored in the machine.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/404",
              "help": {
                "text": "- If possible, do not use functions that execute commands in the system with inputs controlled by the user.\n- Validate all input parameters using regular expressions or whitelists before passing the parameters to critical functions.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "410",
              "name": "Dependency Confusion",
              "fullDescription": {
                "text": "The application incorrectly defines the dependencies to be used. This generates some ambiguity that can be used by an attacker to confuse the package manager in charge of installing or updating the project's dependencies, with the aim of executing potentially harmful code, thus increasing the possible attack vectors.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/410",
              "help": {
                "text": "- Set the name of the organization that owns the private dependency in the package manager file.\n\n - Set the organization in both the private and public registry\n of the package manager.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "002",
              "name": "Asymmetric denial of service",
              "fullDescription": {
                "text": "The server is rendered unresponsive as a result of one of the following:\n- An amplification attack, which uses a single request to produce multiple responses.\n- A single malicious request that breaks the application or consumes an enormous amount of resources.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/002",
              "help": {
                "text": "Define a time-out when a query or a search is taking a lot of time processing the information.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "041",
              "name": "Enabled default credentials",
              "fullDescription": {
                "text": "It is possible to use low-strength, default credentials to access system resources, such as the database.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/041",
              "help": {
                "text": "Eliminate the credentials from the storage manager to avoid login attempts with those.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "007",
              "name": "Cross-site request forgery",
              "fullDescription": {
                "text": "The applications configuration allows an attacker to trick authenticated users into executing actions without their consent.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/007",
              "help": {
                "text": "Use of tokens in forms to verify requests done by legitimate users.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "062",
              "name": "Concurrent sessions",
              "fullDescription": {
                "text": "The application does not validate the number of active sessions each user has, thus a user can login more than once at the same time. Furthermore, the application does not notify the user when a session has already been initiated nor when a second one commences from a different location.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/062",
              "help": {
                "text": "The system must restrict the number of concurrent sessions that a user can establish and at the same it must notify the user when a login from a different location occurs.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "204",
              "name": "Insufficient data authenticity validation",
              "fullDescription": {
                "text": "The application does not control on the server if someone have permission to modify certain fields and allows to use invalid data in some fields, for example non-existing names.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/204",
              "help": {
                "text": "Validate on the server side the types of data that are entered into different types of fields in the application.\n"
              },
              "properties": {
                "auto_approve": true
              }
            },
            {
              "id": "280",
              "name": "Session Fixation",
              "fullDescription": {
                "text": "The cookie session doesn't change after a valid login which allow an attacker to hijack the user session by setting the user cookie for one known by the attacker.\n"
              },
              "helpUri": "https://db.fluidattacks.com/wek/280",
              "help": {
                "text": "Invalidate the anonymous cookie and create a new one after a successful login.\n"
              },
              "properties": {
                "auto_approve": true
              }
            }
          ]
        }
      },
      "versionControlProvenance": [
        {
          "repositoryUri": "https://github.com/manujimeneza/juice-shop",
          "revisionId": "0000000000000000000000000000000000000000",
          "branch": "paso3-estricto"
        }
